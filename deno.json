{
  "lint": {
    "rules": {
      "exclude": ["no-slow-types"]
    }
  },
  "nodeModulesDir": "auto",
  "workspace": ["packages/*", "apps/*"],
  "tasks": {
    "scraper:scrape": "deno task -f @freebies/scraper scrape",
    "claimer:claim": "deno task -f @freebies/claimer claim",
    "db:studio": "deno task -f @freebies/db db:studio",
    "db:reset": "deno task -f @freebies/db db:reset",
    "db:push": "deno task -f @freebies/db db:push",
    "db:seed": "deno task -f @freebies/db db:seed"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "neverthrow": "npm:neverthrow@^8.2.0",
    "patchright": "npm:patchright@^1.61.1",
    "prettier": "npm:prettier@^3.9.6",
    "prettier-plugin-organize-imports": "npm:prettier-plugin-organize-imports@^4.3.0",
    "zod": "npm:zod@^4.4.3"
  }
}
