{
  "name": "@freebies/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "db:studio": "drizzle-kit studio --verbose",
    "db:reset": "tsx --env-file-if-exists=.env src/reset.ts",
    "db:push": "drizzle-kit push --force",
    "db:seed": "pnpm db:reset && pnpm db:push && tsx --env-file-if-exists=.env src/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "neverthrow": "catalog:",
    "zod": "catalog:",
    "drizzle-orm": "rc",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "dotenv": "^18.0.7",
    "drizzle-kit": "rc",
    "tsx": "catalog:"
  }
}
